# Backend API Port
PORT=3001

# Supabase PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:password@db.your-id.supabase.co:5432/postgres"

# Gemini inference API key
GEMINI_API_KEY="your_gemini_api_key"

# Pinecone API Key and Host URL
PINECONE_API_KEY="pcsk_your_pinecone_key"
PINECONE_INDEX_HOST="https://your-index-host.pinecone.io"

# CORS Origin (Frontend URL) — must be the exact client origin for cross-site cookies to work
CORS_ORIGIN="http://localhost:5173"

# Public URL of the frontend app, used in verification/reset email links
APP_BASE_URL="http://localhost:5173"

# Set only in production if client and server share a parent domain (e.g. ".dociq.app").
# Leave unset for cross-origin deployments (e.g. two separate Vercel projects).
# COOKIE_DOMAIN=".dociq.app"

# --- Auth secrets — generate with: openssl rand -hex 32 ---
JWT_ACCESS_SECRET="replace_with_64_char_random_hex"
JWT_REFRESH_SECRET="replace_with_64_char_random_hex"
GUEST_SESSION_SECRET="replace_with_64_char_random_hex"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (Gmail SMTP) — used for verify-email / password-reset links ---
# Prereqs: enable 2-Step Verification on the Gmail account, then generate an
# App Password at https://myaccount.google.com/apppasswords
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="16_char_app_password"
EMAIL_FROM="DocIQ <youraddress@gmail.com>"

# --- Backblaze B2 (S3-compatible) — original PDF storage ---
B2_KEY_ID="your_b2_key_id"
B2_APPLICATION_KEY="your_b2_application_key"
B2_ENDPOINT="s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_BUCKET_NAME="dociq-documents"
